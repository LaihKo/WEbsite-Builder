// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  // Admin-organization only (grouping in the /admin quiz list) — not part
  // of quiz-core's Quiz shape, not used by quiz-taking or scoring logic.
  folder      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]
  attempts  QuizAttempt[]

  @@index([folder])
}

model Question {
  id              String   @id @default(cuid())
  quizId          String
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  order           Int
  prompt          String
  points          Int      @default(1)
  correctOptionId String
  // Freeform lowercase labels (no leading "#"), e.g. ["disney", "movies"].
  tags            String[] @default([])

  options Option[]

  @@unique([quizId, order])
  @@index([tags], type: Gin)
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  // Stable per-question identifier ("a"-"d") — this is what quiz-core's
  // Question.correctOptionId and Answer.selectedOptionId reference, not the
  // Prisma-generated `id` above.
  value      String
  text       String

  @@unique([questionId, value])
}

model QuizAttempt {
  id             String   @id @default(cuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers        Json
  correctCount   Int
  totalQuestions Int
  scorePoints    Int
  maxPoints      Int
  percentage     Int
  createdAt      DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([quizId, createdAt])
  @@index([userId])
}

// Real-time-ish (polling-based) multiplayer "vote on a category" game mode.
// Draws questions ad hoc from Question.tags across all quizzes, rather than
// playing one fixed Quiz — deliberately not modeled as a Quiz/QuizAttempt.

model GameSession {
  id                   String    @id @default(cuid())
  code                 String    @unique
  // "lobby" | "voting" | "playing" | "round-summary" | "tiebreak" | "completed"
  status               String    @default("lobby")
  // The 3 tags offered to players during the "voting" phase, for the
  // current round.
  categoryChoices      String[]  @default([])
  // Winning tag for the current round, set once voting resolves.
  category             String?
  // Question ids drawn so far, across all rounds played, in play order —
  // this keeps growing round to round rather than resetting, so scoreQuiz()
  // can score cumulatively against the full history with no extra bookkeeping.
  questionIds          String[]  @default([])
  currentQuestionIndex Int       @default(0)
  // Index into questionIds where the current round's questions begin — a
  // round isn't guaranteed to be exactly QUESTIONS_PER_ROUND long (a thin
  // category tag can have fewer available), so this (not roundIndex *
  // QUESTIONS_PER_ROUND) is the source of truth for round boundaries.
  roundStartIndex      Int       @default(0)
  // When the question at currentQuestionIndex was shown — the answer timer
  // (QUESTION_TIMER_SECONDS) counts down from this.
  questionStartedAt    DateTime?
  // 0-based; a game is TOTAL_ROUNDS rounds of QUESTIONS_PER_ROUND questions.
  roundIndex           Int       @default(0)
  // Winning tags from previous rounds, excluded from later rounds' category
  // choices so the same category isn't offered twice in one game.
  usedTags             String[]  @default([])

  // Tiebreak: only entered if 2+ players are tied for the top score after
  // the final round. Set once, resolved once — a game only ever needs at
  // most one tiebreak question.
  tiebreakerQuestionId String?
  tiebreakerQuestion   TiebreakerQuestion? @relation(fields: [tiebreakerQuestionId], references: [id])
  // Seats of the tied players — only they can submit a guess; everyone else
  // is a spectator for this phase.
  tiebreakSeats        Int[]               @default([])
  // seat (as string key) -> numeric guess.
  tiebreakAnswers      Json                @default("{}")
  tiebreakStartedAt    DateTime?

  // Final winning seat(s) once status is "completed" — usually the sole top
  // scorer, or the tiebreak winner if the top score was tied.
  winnerSeats Int[] @default([])

  createdAt DateTime @default(now())

  players GamePlayer[]

  @@index([createdAt])
}

model TiebreakerQuestion {
  id        String   @id @default(cuid())
  // A "closest guess wins" trivia prompt with a definitive (if arbitrary)
  // numeric answer — used only to break a tie for the top score at the end
  // of a game, typed in rather than multiple-choice.
  prompt    String
  answer    Float
  createdAt DateTime @default(now())

  gameSessions GameSession[]
}

model GamePlayer {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  // 1-6, assigned at join time.
  seat      Int
  name      String
  votedTag  String?
  // Answer[]-shaped (quiz-core), appended to as the player answers each
  // question — scored on read with quiz-core's scoreQuiz() against a
  // synthetic Quiz built from questionIds, not stored redundantly here.
  answers   Json        @default("[]")
  joinedAt  DateTime    @default(now())

  @@unique([sessionId, seat])
}

// Auth.js (next-auth v5) Prisma adapter schema: https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts     Account[]
  sessions     Session[]
  quizAttempts QuizAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}
