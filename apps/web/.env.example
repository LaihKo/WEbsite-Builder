DATABASE_URL="postgresql://user:password@localhost:5432/quiz_platform?schema=public"

# Generate with `openssl rand -base64 32` (or `npx auth secret`). Required in
# production; the app will error at request time (not build time) without it.
AUTH_SECRET=""

# OAuth app credentials - see ARCHITECTURE.md "Authentication" section for
# where to create these and which redirect URIs to register.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_FACEBOOK_ID=""
AUTH_FACEBOOK_SECRET=""

# Password for /admin (quiz upload) — a single shared secret, unrelated to
# the OAuth login above. Generate with `openssl rand -base64 24`. See
# ARCHITECTURE.md "Admin / content management" section.
ADMIN_SECRET=""
